+/// A text request to a dynamic public HTTPS origin, DNS-pinned like `send_raw_bytes`.
+async fn send_dynamic_request(
+    url: reqwest::Url,
+    method: reqwest::Method,
+    headers: HeaderMap,
+    body: Option<String>,
+    deadline: Duration,
+    addresses: &[std::net::SocketAddr],
+) -> Result<HostResponse, String> {
+    let mut builder = reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .retry(reqwest::retry::never())
+        .no_proxy()
+        .pool_max_idle_per_host(0)
+        .timeout(deadline);
+    if let Some(name) = url.domain() {
+        builder = builder.resolve_to_addrs(name, addresses);
+    }
+    let client = builder
+        .build()
+        .map_err(|_| "Host request client is unavailable")?;
+    let mut request = client.request(method, url).headers(headers);
+    if let Some(body) = body {
+        request = request.body(body);
+    }
+    read_response(request).await
+}
