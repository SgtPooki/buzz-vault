+        .redirect(reqwest::redirect::Policy::none())
+        .retry(reqwest::retry::never())
+        .timeout(DEADLINE);
+    if let SendReach::Dynamic(addresses) = &reach {
+        builder = builder.no_proxy().pool_max_idle_per_host(0);
+        if let Some(name) = url.domain() {
+            builder = builder.resolve_to_addrs(name, addresses);
+        }
+    }
+    let client = builder
+        .build()
+        .map_err(|_| "Host request client is unavailable")?;
+    let mut request = client.request(method, url);
+    if let Some(content_type) = &send.content_type {
+        request = request.header(reqwest::header::CONTENT_TYPE, content_type);
+    }
+    read_response(request.body(bytes.to_vec())).await
