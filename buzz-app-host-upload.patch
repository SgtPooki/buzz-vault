+
+async fn send_reach(grants: &HostGrants, url: &reqwest::Url) -> Result<SendReach, String> {
+    if allows_origin(grants, url) {
+        Ok(SendReach::Declared)
+    } else if grants.dynamic_uploads {
+        let addresses = public_image::public_addresses(url).await?;
+        Ok(SendReach::Dynamic(addresses))
+    } else {
+        Err("Host request origin is not declared".into())
+    }
+}
+
+fn validate_byte_send(send: &ByteSend, bytes: &[u8]) -> Result<(reqwest::Url, reqwest::Method), String> {
+    if bytes.is_empty() || bytes.len() > MAX_RESPONSE_BYTES {
+        return Err("Invalid upload bytes".into());
+    }
+    let method = match send.method.to_ascii_uppercase().as_str() {
+        "PUT" => reqwest::Method::PUT,
+        "POST" => reqwest::Method::POST,
+        _ => return Err("Send method must be PUT or POST".into()),
+    };
+    if let Some(ct) = &send.content_type {
+        if ct.is_empty() || ct.len() > 256 || ct.contains('\r') || ct.contains('\n') {
+            return Err("Invalid content type".into());
+        }
+    }
+    let (url, _, _) = validate_request(&HostRequest {
+        url: send.url.clone(),
+        method: method.as_str().into(),
+        headers: BTreeMap::new(),
+        body: None,
+        timeout_ms: send.timeout_ms,
+    })?;
+    Ok((url, method))
+}
